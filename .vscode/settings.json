{
	"biome.lsp.bin": "node_modules/@biomejs/biome/bin/biome",
	"biome.enabled": true,
	"biome.configurationPath": "biome.json",
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "always",
		"source.organizeImports.biome": "always"
	},
	"files.trimTrailingWhitespace": true,
	"files.trimFinalNewlines": true,
	"files.insertFinalNewline": true,
	"tailwindCSS.validate": true,
	"tailwindCSS.lint.cssConflict": "warning",
	"tailwindCSS.lint.invalidApply": "warning",
	"tailwindCSS.lint.invalidConfigPath": "warning",
	"tailwindCSS.lint.invalidScreen": "warning",
	"tailwindCSS.lint.invalidVariant": "warning",
	"tailwindCSS.classAttributes": [
		"className",
		"enter",
		"enterFrom",
		"enterTo",
		"leave",
		"leaveFrom",
		"leaveTo",
		"lineClassName",
		"handleClassName"
	],
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	}
}
